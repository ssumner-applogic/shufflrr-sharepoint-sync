{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "sync:run": "node --enable-source-maps ./dist/sync.mjs",
    "sync:watch": "node --enable-source-maps ./dist/sync-watch.mjs",
    "metadata:watch": "node --enable-source-maps ./dist/metadata-watch.mjs",
    "metadata:check": "node --enable-source-maps ./dist/metadata-watch.mjs --once --first-ten",
    "test:metadata": "pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/lib/metadata.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:sync-postgres": "pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/lib/sync-scheduling.postgres.test.ts",
    "test:sync": "pnpm --filter @workspace/scripts exec tsx --test ../artifacts/api-server/src/lib/sync-protections.test.ts ../artifacts/api-server/src/lib/sync-transfer.test.ts ../artifacts/api-server/src/lib/sync-inventory.test.ts ../artifacts/api-server/src/lib/sync-file-progress.test.ts ../artifacts/api-server/src/lib/sync-disconnect.test.ts ../artifacts/api-server/src/lib/sync-scheduling.test.ts ../artifacts/api-server/src/lib/sync-retry-queue.test.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.88",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/shufflrr": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0"
  }
}
