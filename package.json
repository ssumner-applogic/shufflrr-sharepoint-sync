{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "test:sync-selection": "pnpm --filter @workspace/scripts exec tsx --test ../artifacts/sharepoint-browser/src/components/sync/folder-selection.test.ts ../artifacts/sharepoint-browser/src/components/sync/failureGrouping.test.ts ../artifacts/sharepoint-browser/src/components/sync/activity-selection.test.ts",
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm --filter @workspace/sharepoint-browser run build && pnpm --filter @workspace/api-server run build",
    "start": "SERVE_FRONTEND=true node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "shufflrr:validate": "pnpm --silent --filter @workspace/scripts run shufflrr:validate",
    "shufflrr:probe": "pnpm --silent --filter @workspace/scripts run shufflrr:probe",
    "test:shufflrr": "pnpm --filter @workspace/scripts run test:shufflrr",
    "db:migrate": "pnpm --filter @workspace/db run migrate",
    "sync:run": "pnpm --filter @workspace/api-server run sync:run",
    "sync:watch": "node --enable-source-maps artifacts/api-server/dist/sync-watch.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
