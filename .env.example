MICROSOFT_TENANT_ID=replace-with-tenant-id
MICROSOFT_CLIENT_ID=replace-with-client-id
MICROSOFT_CLIENT_SECRET=replace-with-secret-value
# Clerk publishable key is safe to return to the browser; keep the secret key server-only.
CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-clerk-secret-key
# Optional: independent HMAC key for pagination cursors.
SESSION_SECRET=replace-with-random-secret
# Optional standalone Shufflrr CLI; never expose these credentials to frontend code.
SHUFFLRR_API_BASE_URL=https://your-portal.shufflrr.com/api
SHUFFLRR_API_EMAIL=service-account@example.invalid
SHUFFLRR_API_PASSWORD=replace-with-service-account-password
